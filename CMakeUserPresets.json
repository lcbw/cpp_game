{
  "version": 2,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 14,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "dev-common",
      "hidden": true,
      "inherits": ["dev-mode", "vcpkg", "clang-tidy", "cppcheck"],
      "cacheVariables": {
        "BUILD_MCSS_DOCS": "ON"
      }
    },
    {
      "name": "dev-linux",
      "binaryDir": "${sourceDir}/build/dev-linux",
      "inherits": ["dev-common", "ci-linux"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
    "name": "dev",
    "binaryDir": "${sourceDir}/build/dev",
    "inherits": ["dev-mode", "vcpkg", "ci-linux"],
   "generator": "Ninja",
    "environment": {
    "VCPKG_ROOT": "/home/lily/cpp_boilerplate/vcpkg/vcpkg"
  },
  "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }

    },
    {
      "name": "dev-coverage",
      "binaryDir": "${sourceDir}/build/coverage",
      "inherits": ["dev-mode", "coverage-linux", "vcpkg"]
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "configuration": "Debug",
      "jobs": 22
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 22,
        "noTestsAction": "error"
      }
    }
  ]
}
